{
  "buildCommand": "npm run build",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/:path((?!assets).*)",
      "destination": "/api/index.mjs"
    }
  ],
  "outputDirectory": "dist/serverless/client"
}
