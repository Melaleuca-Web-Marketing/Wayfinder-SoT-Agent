RIVERBEND_DOMAIN=melaleuca.com/riverbendranch
WEB_CACHE_TTL_SECONDS=86400
VECTOR_STORE_ID=
VECTOR_URL_ALLOWLIST=*
MAX_URL_BYTES=5242880
URL_FETCH_TIMEOUT_MS=15000
VECTOR_URL_AUTH_MODE=none
VECTOR_URL_AUTH_DOMAIN=
VECTOR_URL_AUTH_COOKIE=
VECTOR_URL_AUTH_COOKIE_FILE=authcookie.sh
VECTOR_URL_USER_AGENT=
